# ============================================================
# Regional Media Intelligence Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# All AI processing uses LOCAL/OPEN-SOURCE models.
# NO external AI API keys (OpenAI, Gemini, Claude, etc.) are required.
# ============================================================

# --- Database ---
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://rmi_user:rmi_password@localhost:5432/rmi_db

# --- File Storage ---
# Base path for all file storage (uploads, rendered pages, thumbnails)
STORAGE_PATH=./storage
UPLOAD_PATH=./storage/uploads
PAGE_IMAGE_PATH=./storage/pages

# --- OCR Configuration ---
# OCR engine selection: auto | paddleocr | tesseract | easyocr | hybrid
# "auto" will detect available engines and pick the best one
OCR_ENGINE=auto
# Custom path to OCR models (leave empty for defaults)
OCR_MODEL_PATH=
# Path to Tesseract executable (leave empty to use system PATH)
TESSERACT_PATH=

# --- Translation ---
# HuggingFace model ID or local path for translation
# Default: facebook/nllb-200-distilled-600M (~1.2GB)
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_MODEL_PATH=

# --- Named Entity Recognition ---
# Custom NER model path (leave empty for defaults: spaCy + IndicNER)
NER_MODEL_PATH=
# spaCy model to use for English NER
SPACY_MODEL=en_core_web_sm

# --- Sentiment & Classification ---
# Multilingual sentiment model
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment-multilingual
CLASSIFICATION_MODEL_PATH=

# --- Application ---
# Secret key for session/token signing (CHANGE THIS IN PRODUCTION)
SECRET_KEY=change-me-in-production-use-a-real-secret
APP_NAME=Regional Media Intelligence Agent
# Environment: development | staging | production
APP_ENV=development
# Enable debug mode (disable in production)
DEBUG=true
# Demo mode: uses deterministic fallbacks, works without model downloads
DEMO_MODE=true

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# # --- SMTP (Optional — for email alerts) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL_TO=

# --- Processing ---
# Maximum upload file size in MB
MAX_UPLOAD_SIZE_MB=100
# OCR confidence threshold (below this → human review)
OCR_CONFIDENCE_THRESHOLD=90
# Number of background processing workers
PROCESSING_WORKERS=2
